              "line": {
                "type": "string"
              },
              "before": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "after": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "lineNumber",
              "line",
              "before",
              "after"
            ],
            "additionalProperties": false
          }
        },
        "totalMatches": {
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        },
        "skippedLongLines": {
          "type": "integer"
        },
        "totalLines": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "contentTrust": {
          "const": "untrusted-user-script-source"
        }
      },
      "required": [
        "uuid",
        "name",
        "matches",
        "totalMatches",
        "truncated",
        "skippedLongLines",
        "totalLines",
        "sha256",
        "contentTrust"
      ],
      "additionalProperties": false
