        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        }
      },
      "required": [
        "uuid"
      ],
      "additionalProperties": false
    },
    "ScriptsSourceGrepParams": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string",
          "format": "uuid"
        },
        "query": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "text",
            "regex"
          ]
        },
        "ignoreCase": {
          "type": "boolean"
        },
        "contextLines": {
          "type": "integer",
          "minimum": 0
        },
        "maxMatches": {
          "type": "integer",
          "minimum": 1
        }
