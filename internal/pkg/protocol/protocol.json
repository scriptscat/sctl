    "ScriptSource": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "contentTrust": {
