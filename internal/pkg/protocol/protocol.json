      "type": "object",
      "properties": {
        "scripts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "namespace": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "normal",
                  "crontab",
                  "background"
                ]
              },
              "enabled": {
                "type": "boolean"
              },
              "updatedAt": {
                "type": "string"
              },
              "hasUpdateUrl": {
                "type": "boolean"
              }
            },
            "required": [
              "uuid",
              "name",
              "namespace",
              "type",
              "enabled",
              "updatedAt",
              "hasUpdateUrl"
            ],
            "additionalProperties": false
          }
        },
        "contentTrust": {
          "const": "untrusted-user-script-metadata"
        }
      },
      "required": [
        "scripts",
        "contentTrust"
      ],
      "additionalProperties": false
    },
