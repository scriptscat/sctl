        "description": {
          "type": "string"
        },
        "type": {
          "enum": [
            "normal",
            "crontab",
            "background"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string"
        },
        "hasUpdateUrl": {
          "type": "boolean"
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "grants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "connects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runAt": {
          "type": "string"
        },
        "crontab": {
          "type": "string"
        },
        "contentTrust": {
          "const": "untrusted-user-script-metadata"
        }
      },
      "required": [
        "uuid",
        "name",
        "namespace",
        "type",
        "enabled",
        "updatedAt",
        "hasUpdateUrl",
        "matches",
        "includes",
        "excludes",
        "grants",
        "connects",
        "requires",
        "resources",
        "contentTrust"
